<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Action -->
    <record id="action_gmp_weighing_monitoring" model="ir.actions.act_window">
        <field name="name">Chuẩn bị và cân định lượng NPL</field>
        <field name="res_model">gmp.weighing.monitoring</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_noodle_production_log_root" name="Nhật ký sản xuất mì" sequence="10"/>
    <menuitem
        id="menu_gmp_weighing_monitoring"
        name="Chuẩn bị và cân định lượng NPL"
        parent="menu_noodle_production_log_root"
        action="action_gmp_weighing_monitoring"
        sequence="10"
    />

    <!-- Tree view -->
    <record id="view_gmp_weighing_monitoring_tree" model="ir.ui.view">
        <field name="name">gmp.weighing.monitoring.tree</field>
        <field name="model">gmp.weighing.monitoring</field>
        <field name="arch" type="xml">
            <tree>
                <field name="log_datetime"/>
                <field name="log_date" invisible="1"/> 
                <field name="productionplan_id"/>
                <field name="productionplancode"/>
                <field name="productionplanname"/>
                <field name="productionplanfactory"/>
                <field name="line_id"/>
                <field name="linecode"/>
                <field name="linename"/>
                <field name="item_id"/>
                <field name="itemcode"/>
                <field name="itemname"/>
                <field name="fromts"/>
                <field name="tots"/>
                <field name="material_id"/>
                <field name="materialcode"/>
                <field name="materialname"/>
                <field name="lot_code"/>
                <field name="batch_code"/>
                <field name="uom_id"/>
                <field name="uomcode"/>
                <field name="uomname"/>
                <field name="bom_quantity"/>
                <field name="actual_quantity"/>
                <field name="quantity_variance"/>
                <field name="post_weighing_status"/>
                <field name="post_weighing_identification"/>
                <field name="result"/>
                <field name="operator"/>
                <field name="note"/>
                <field name="allowed_item_ids" invisible="1"/>
                <field name="allowed_material_ids" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_gmp_weighing_monitoring_form" model="ir.ui.view">
        <field name="name">gmp.weighing_monitoring.form</field>
        <field name="model">gmp.weighing.monitoring</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="log_datetime"/>
                        <field name="log_date" invisible="1"/> 
                        <field name="productionplan_id" 
                            context="{'search_default_u_docdate': log_date}"
                            domain="[('u_docdate', '=', log_date)]"
                            options="{'no_create': True, 'no_open': True}"/>
                        <field name="productionplancode"/>  
                        <field name="productionplanname"/>
                        <field name="productionplanfactory"/>
                        <field name="line_id"/>
                        <field name="linecode"/>
                        <field name="linename"/>
                        <field name="item_id" options="{'no_open': True}"/>
                        <field name="itemcode"/>
                        <field name="itemname"/> 
                        <field name="fromts"/>
                        <field name="tots"/> 
                        <field name="material_id"/>
                        <field name="materialcode"/>
                        <field name="materialname"/>  
                        <field name="uom_id" options="{'no_open': True}"/>
                        <field name="uomcode"/>
                        <field name="uomname"/>                    
                        <field name="lot_code"/>
                        <field name="batch_code"/>
                    </group>

                    <group string="Cân định lượng">
                        <field name="bom_quantity"/>
                        <field name="actual_quantity"/>
                        <field name="quantity_variance"/>
                    </group>

                    <group string="Đánh giá sau cân - định lượng">
                        <field name="post_weighing_status"/>
                        <field name="post_weighing_identification"/>
                    </group>

                    <group>
                        <field name="result"/>
                        <field name="operator"/>
                        <field name="note"/>
                        <field name="allowed_item_ids" invisible="1"/>
                        <field name="allowed_material_ids" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
