<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_gmp_weighing_monitoring" model="ir.actions.act_window">
        <field name="name">Chuẩn bị và cân định lượng NPL</field>
        <field name="res_model">gmp.weighing.monitoring</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_noodle_production_log_root" name="Nhật ký sản xuất mì" sequence="10"/>
    <menuitem id="menu_gmp_weighing_monitoring" name="Chuẩn bị và cân định lượng NPL" 
              parent="menu_noodle_production_log_root" action="action_gmp_weighing_monitoring" sequence="1"/>

    <record id="view_gmp_weighing_monitoring_tree" model="ir.ui.view">
        <field name="name">gmp.weighing.monitoring.tree</field>
        <field name="model">gmp.weighing.monitoring</field>
        <field name="arch" type="xml">
            <tree string="Danh sách giám sát cân">
                <field name="log_date"/>
                <field name="productionplancode"/>
                <field name="productionplanfactory"/>
                <field name="linecode"/>
                <field name="shiftname"/>
                <field name="productionplanname"/>
            </tree>
        </field>
    </record>

    <record id="view_gmp_weighing_monitoring_form" model="ir.ui.view">
        <field name="name">gmp.weighing.monitoring.form</field>
        <field name="model">gmp.weighing.monitoring</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    
                </header>
                <sheet>
                    <group>
                        <group name="left_header">
                            <field name="log_date" string="Ngày ghi nhận"/>
                            <field name="productionplan_id" 
                                   options="{'no_create': True}"
                                   domain="[('u_docdate', '=', log_date)]"
                                   placeholder="Chọn kế hoạch theo ngày..."/>
                            <field name="productionplancode" readonly="1"/>
                            <field name="productionplanfactory" readonly="1"/>
                        </group>
                        
                        <group name="right_header">
                            <field name="line_id" options="{'no_create': True}"/>
                            <field name="shift_id" options="{'no_create': True}"/>
                            <field name="productionplanname" readonly="1"/>
                            <field name="valid_item_ids" invisible="1"/>
                            <field name="valid_material_ids" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Chi tiết cân định lượng" name="weighing_details">
                            <!-- Danh sách dòng -->
                            <field name="line_ids">
                                <tree delete="0" editable="bottom"> 
                                    <control>
                                        <create name="add_line_control" string="Thêm dòng (Web)"/>
                                        <button name="action_open_weighing_wizard" 
                                                string="Thêm dòng (Mobile)" 
                                                type="object" 
                                                class="btn-primary"/>
                                    </control>
                                    <field name="log_datetime" 
                                                width="300px"
                                                options="{'format': 'HH:mm:ss'}" 
                                                optional="show"/>
                                    <field name="item_id" options="{'no_create': True}"/>
                                    <field name="fromts"/>
                                    <field name="tots"/>
                                    <field name="material_id" options="{'no_create': True}"/>
                                    <field name="materialname" readonly="1"/>
                                    <field name="uom_id" options="{'no_create': True}"/>
                                    <field name="lot_code"/>
                                    <field name="batch_code"/>
                                    <field name="bom_quantity" sum="Tổng"/>
                                    <field name="actual_quantity" sum="Tổng"/>
                                    <field name="quantity_variance" sum="Tổng"/>
                                    <field name="result" decoration-success="result == 'Pass'" decoration-danger="result == 'Fail'"/>
                                    
                                    <button name="action_edit_line" 
                                            type="object" 
                                            icon="fa-pencil" 
                                            class="btn-secondary"/>
                                            
                                    <button name="unlink" 
                                            type="object" 
                                            icon="fa-trash text-danger" 
                                            confirm="Bạn có chắc chắn muốn xóa dòng này?"/>
                                </tree>
                            </field>
                        </page>
                        
                        <page string="Thông tin khác" name="other_info">
                            <group>
                                <field name="linecode" readonly="1"/>
                                <field name="shiftcode" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>