<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree view -->
    <record id="view_base_daily_production_plan_tree" model="ir.ui.view">
        <field name="name">base.daily.production.plan.tree</field>
        <field name="model">base.daily.production.plan</field>
        <field name="arch" type="xml">
            <tree>
                <!-- <field name="docnum"/> -->
                <field name="docnum"/>
                <field name="remark"/>
            </tree>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_base_daily_production_plan_search" model="ir.ui.view">
        <field name="name">base.daily.production.plan.search</field>
        <field name="model">base.daily.production.plan</field>
        <field name="arch" type="xml">
            <search string="Tìm lịch sản xuất">
                <field name="docnum" string="Số kế hoạch"/>
                <field name="remark" string="Ghi chú"/>
            </search>
        </field>
    </record>

</odoo>
