<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_gmp_metal_detection_tree" model="ir.ui.view">
        <field name="name">gmp.metal.detection.tree</field>
        <field name="model">gmp.metal.detection</field>
        <field name="arch" type="xml">
            <tree>
                <field name="log_datetime"/>
                <field name="log_date" optional="hide"/> 
                <field name="productionplan_id" optional="hide"/>
                <field name="productionplancode"/>
                <field name="productionplanname" optional="hide"/>
                <field name="productionplanfactory" optional="hide"/>
                <field name="line_id" optional="hide"/>
                <field name="linecode" optional="hide"/>
                <field name="linename" optional="hide"/>
                <field name="shift_id" optional="hide"/>
                <field name="shiftcode" optional="hide"/>
                <field name="shiftname" optional="hide"/>
                <field name="shift_id" optional="hide"/>
                <field name="shiftcode" optional="hide"/>
                <field name="shiftname" optional="hide"/>
                <field name="item_id" optional="hide"/>
                <field name="itemcode" optional="hide"/>
                <field name="itemname" optional="hide"/>
                <field name="fromts" optional="hide"/>
                <field name="tots" optional="hide"/>

                <field name="machine_id" optional="hide"/>
                <field name="machine_type" optional="hide"/>
                <field name="fe_type" optional="hide"/>
                <field name="nonfe_type" optional="hide"/>
                <field name="sus_type" optional="hide"/>

                <field name="lot_code" optional="hide"/>
                <field name="batch_code" optional="hide"/>
                <field name="quantity_of_products_scanned" optional="hide"/>  
                <field name="quantity_of_products_detected" optional="hide"/> 

                <field name="fe_detected" optional="hide"/>
                <field name="nonfe_detected" optional="hide"/>  
                <field name="sus_detected" optional="hide"/>

                <field name="re_scanned" optional="hide"/>
                <field name="isolated" optional="hide"/>  
                <field name="opened" optional="hide"/>

                <field name="result"/>
                <field name="operator"/>
                <field name="note"/>
                <field name="allowed_item_ids" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_gmp_metal_detection_form" model="ir.ui.view">
        <field name="name">gmp.metal.detection.form</field>
        <field name="model">gmp.metal.detection</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="log_datetime"/>
                        <field name="log_date" invisible="1"/> 
                        <field name="productionplan_id" 
                            context="{'search_default_u_docdate': log_date}"
                            domain="[('u_docdate', '=', log_date)]"
                            options="{'no_create': True, 'no_open': True}"/>
                        <field name="productionplancode"/>  
                        <field name="productionplanname"/>
                        <field name="productionplanfactory"/>  
                        <field name="line_id"/>
                        <field name="linecode"/>
                        <field name="linename"/>
                        <field name="shift_id"/>
                        <field name="shiftcode"/>
                        <field name="shiftname"/>
                        <field name="item_id"/>
                        <field name="itemcode"/>
                        <field name="itemname"/>
                        <field name="fromts"/>
                        <field name="tots"/>                                            
                    </group>

                    <group string="Thử độ nhạy máy dò kim loại qua Kit Test">   
                        <field name="machine_id"/>
                        <field name="machine_type"/>
                        <field name="fe_type"/>
                        <field name="nonfe_type"/>
                        <field name="sus_type"/>
                    </group>
                    
                    <group> 
                        <field name="lot_code"/>
                        <field name="batch_code"/>
                        <field name="quantity_of_products_scanned"/>  
                        <field name="quantity_of_products_detected"/> 
                    </group>

                    <group string="Số lượng/Loại phát hiện">   
                        <field name="fe_detected"/>
                        <field name="nonfe_detected"/>  
                        <field name="sus_detected"/>
                    </group>

                    <group string="Số lượng/ Cách thức xử lý">  
                        <field name="re_scanned"/>
                        <field name="isolated"/>  
                        <field name="opened"/>            
                    </group>

                    <group>
                        <field name="result"/>
                        <field name="operator"/>
                        <field name="note"/>
                        <field name="allowed_item_ids" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_gmp_metal_detection" model="ir.actions.act_window">
        <field name="name">Dò kim loại sản phẩm</field>
        <field name="res_model">gmp.metal.detection</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_gmp_metal_detection"
        name="Dò kim loại sản phẩm"
        parent="gmp_weighing_monitoring.menu_noodle_production_log_root"
        action="action_gmp_metal_detection"
        sequence="17"
    />

</odoo>
