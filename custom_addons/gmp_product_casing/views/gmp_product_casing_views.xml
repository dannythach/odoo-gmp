<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_gmp_product_casing_tree" model="ir.ui.view">
        <field name="name">gmp.product.casing.tree</field>
        <field name="model">gmp.product.casing</field>
        <field name="arch" type="xml">
            <tree>
                <field name="log_datetime"/>
                <field name="log_date" optional="hide"/> 
                <field name="productionplan_id" optional="hide"/>
                <field name="productionplancode"/>
                <field name="productionplanname" optional="hide"/>
                <field name="productionplanfactory" optional="hide"/>
                <field name="line_id" optional="hide"/>
                <field name="linecode" optional="hide"/>
                <field name="linename" optional="hide"/>
                <field name="shift_id" optional="hide"/>
                <field name="shiftcode" optional="hide"/>
                <field name="shiftname" optional="hide"/>
                <field name="shift_id" optional="hide"/>
                <field name="shiftcode" optional="hide"/>
                <field name="shiftname" optional="hide"/>
                <field name="item_id" optional="hide"/>
                <field name="itemcode" optional="hide"/>
                <field name="itemname" optional="hide"/>
                <field name="fromts" optional="hide"/>
                <field name="tots" optional="hide"/>

                <field name="machine_id" optional="hide"/>
                <field name="specifications" optional="hide"/>
                <field name="quantity_case" optional="hide"/>
                <field name="inspected_cases" optional="hide"/>
                <field name="passed_cases" optional="hide"/>
                <field name="rejected_cases" optional="hide"/>
                <field name="defect_type" optional="hide"/>

                <field name="result"/>
                <field name="operator"/>
                <field name="note"/>
                <field name="allowed_item_ids" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_gmp_product_casing_form" model="ir.ui.view">
        <field name="name">gmp.product.casing.form</field>
        <field name="model">gmp.product.casing</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="log_datetime"/>
                        <field name="log_date" invisible="1"/> 
                        <field name="productionplan_id" 
                            context="{'search_default_u_docdate': log_date}"
                            domain="[('u_docdate', '=', log_date)]"
                            options="{'no_create': True, 'no_open': True}"/>
                        <field name="productionplancode"/>  
                        <field name="productionplanname"/>
                        <field name="productionplanfactory"/>  
                        <field name="line_id"/>
                        <field name="linecode"/>
                        <field name="linename"/>
                        <field name="shift_id"/>
                        <field name="shiftcode"/>
                        <field name="shiftname"/>
                        <field name="item_id"/>
                        <field name="itemcode"/>
                        <field name="itemname"/>
                        <field name="fromts"/>
                        <field name="tots"/>                                            
                    </group>

                    <group>   
                        <field name="machine_id"/>
                        <field name="specifications"/>
                        <field name="quantity_case"/>
                        <field name="inspected_cases"/>
                        <field name="passed_cases"/>
                        <field name="rejected_cases"/>
                        <field name="defect_type"/>           
                    </group>

                    <group>
                        <field name="result"/>
                        <field name="operator"/>
                        <field name="note"/>
                        <field name="allowed_item_ids" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_gmp_product_casing" model="ir.actions.act_window">
        <field name="name">Đóng thùng sản phẩm</field>
        <field name="res_model">gmp.product.casing</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_gmp_product_casing"
        name="Đóng thùng sản phẩm"
        parent="gmp_weighing_monitoring.menu_noodle_production_log_root"
        action="action_gmp_product_casing"
        sequence="17"
    />

</odoo>
