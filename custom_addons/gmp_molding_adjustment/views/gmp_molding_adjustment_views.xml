<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_gmp_molding_adjustment_tree" model="ir.ui.view">
        <field name="name">gmp.molding.adjustment.tree</field>
        <field name="model">gmp.molding.adjustment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="log_datetime"/>
                <field name="log_date" optional="hide"/> 
                <field name="productionplan_id" optional="hide"/>
                <field name="productionplancode"/>
                <field name="productionplanname" optional="hide"/>
                <field name="productionplanfactory" optional="hide"/>
                <field name="line_id" optional="hide"/>
                <field name="linecode" optional="hide"/>
                <field name="linename" optional="hide"/>
                <field name="shift_id" optional="hide"/>
                <field name="shiftcode" optional="hide"/>
                <field name="shiftname" optional="hide"/>
                <field name="shift_id" optional="hide"/>
                <field name="shiftcode" optional="hide"/>
                <field name="shiftname" optional="hide"/>
                <field name="item_id" optional="hide"/>
                <field name="itemcode" optional="hide"/>
                <field name="itemname" optional="hide"/>
                <field name="fromts" optional="hide"/>
                <field name="tots" optional="hide"/>
                <field name="lot_code" optional="hide"/>
                <field name="batch_code" optional="hide"/>
                <field name="mold_code" optional="hide"/>
                <field name="adjustment_stick_diameter" optional="hide"/>
                <field name="adjustment_stick_length" optional="hide"/>
                <field name="distance_stick_mold" optional="hide"/>
                <field name="air_flow_rate" optional="hide"/>
                <field name="air_pressure" optional="hide"/>  
                <field name="fan_speed" optional="hide"/>
                <field name="fan_wind_speed" optional="hide"/>   
                <field name="sfp_status" optional="hide"/>          
                <field name="result"/>
                <field name="operator"/>
                <field name="note"/>
                <field name="allowed_item_ids" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_gmp_molding_adjustment_form" model="ir.ui.view">
        <field name="name">gmp.molding.adjustment.form</field>
        <field name="model">gmp.molding.adjustment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="log_datetime"/>
                        <field name="log_date" invisible="1"/> 
                        <field name="productionplan_id" 
                            context="{'search_default_u_docdate': log_date}"
                            domain="[('u_docdate', '=', log_date)]"
                            options="{'no_create': True, 'no_open': True}"/>
                        <field name="productionplancode"/>  
                        <field name="productionplanname"/>
                        <field name="productionplanfactory"/>  
                        <field name="line_id"/>
                        <field name="linecode"/>
                        <field name="linename"/>
                        <field name="shift_id"/>
                        <field name="shiftcode"/>
                        <field name="shiftname"/>
                        <field name="item_id"/>
                        <field name="itemcode"/>
                        <field name="itemname"/>
                        <field name="fromts"/>
                        <field name="tots"/>                                            
                        <field name="lot_code"/>
                        <field name="batch_code"/>
                    </group>

                    <group>   
                        <field name="mold_code"/>
                        <field name="adjustment_stick_diameter"/>
                        <field name="adjustment_stick_length"/>
                        <field name="distance_stick_mold"/>
                        <field name="air_flow_rate"/>
                        <field name="air_pressure"/>  
                        <field name="fan_speed"/>
                        <field name="fan_wind_speed"/>   
                        <field name="sfp_status"/>        
                    </group>

                    <group>
                        <field name="result"/>
                        <field name="operator"/>
                        <field name="note"/>
                        <field name="allowed_item_ids" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_gmp_molding_adjustment" model="ir.actions.act_window">
        <field name="name">Sửa khuôn</field>
        <field name="res_model">gmp.molding.adjustment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_gmp_molding_adjustment"
        name="Sửa khuôn"
        parent="gmp_weighing_monitoring.menu_noodle_production_log_root"
        action="action_gmp_molding_adjustment"
        sequence="11"
    />

</odoo>
