<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="gmp_molding_adjustment_wizard_view_form" model="ir.ui.view">
            <field name="name">gmp.molding.adjustment.wizard.form</field>
            <field name="model">gmp.molding.adjustment.wizard</field>
            <field name="arch" type="xml">
                <form string="Thông số">
                    <sheet>
                        <!-- <field name="valid_item_ids" invisible="1"/> -->
                        <field name="valid_material_ids" invisible="1"/>
                        <field name="header_id" invisible="1"/>
                        <field name="line_id" invisible="1"/>

                        <div class="oe_title" invisible="not line_id">
                            <span class="badge rounded-pill text-bg-info" style="font-size: 14px;">Chế độ: Chỉnh sửa dòng cũ</span>
                        </div>
                        <div class="oe_title" invisible="line_id">
                            <span class="badge rounded-pill text-bg-success" style="font-size: 14px;">Chế độ: Thêm dòng mới</span>
                        </div>

                        <group>
                            <group string="Thông tin sản phẩm">
                                <field name="log_datetime"/>
                            </group>
                        </group>

                        <group string="Thông tin ghi nhận">
                            <group>
                                <field name="lot_code" placeholder="Nhập mã lô..."/>
                                <field name="batch_code" placeholder="Nhập mã mẻ..."/>
                            </group>
                            <group>
                                <field name="adjustment_stick_diameter"/>
                                <field name="adjustment_stick_length"/>
                                <field name="distance_stick_mold"/>
                                <field name="air_flow_rate"/>
                                <field name="air_pressure"/>
                                <field name="fan_speed"/>
                                <field name="fan_wind_speed"/>
                                <field name="sfp_status"/>
                            </group>
                        </group>
                        
                        <group string="Xác nhận">
                            <field name="result" widget="radio" options="{'horizontal': true}"/>
                            <field name="operator"/>
                            <field name="note" placeholder="Ghi chú chi tiết nếu có..."/>
                        </group>
                    </sheet>
                    <footer>
                        
                        <button string="Lưu &amp; Đóng" name="action_confirm" type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Lưu &amp; Tạo mới" name="action_confirm_and_new" type="object" class="btn-primary"/>
                        <button string="Đóng" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>