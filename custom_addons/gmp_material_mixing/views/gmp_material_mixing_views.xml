<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_gmp_material_mixing_tree" model="ir.ui.view">
        <field name="name">gmp.material.mixing.tree</field>
        <field name="model">gmp.material.mixing</field>
        <field name="arch" type="xml">
            <tree>
                <field name="log_datetime"/>
                <field name="productionplan_id"/>
                <field name="productionplancode"/>
                <field name="productionplanname"/>
                <field name="productionplanfactory"/>
                <field name="item_id"/>
                <field name="itemcode"/>
                <field name="itemname"/>
                <field name="fromts"/>
                <field name="tots"/>
                <field name="lot_code"/>
                <field name="batch_code"/>
                <field name="equipment_code"/>
                <field name="mixing_time"/>
                <field name="dough_temperature"/>
                <field name="dough_status"/>
                <field name="result"/>
                <field name="operator"/>
                <field name="note"/>
                <field name="allowed_item_ids" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_gmp_material_mixing_form" model="ir.ui.view">
        <field name="name">gmp.material.mixing.form</field>
        <field name="model">gmp.material.mixing</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="log_datetime"/>
                        <field name="productionplan_id" options="{'no_open': True}" force_save="1"/>
                        <field name="productionplancode"/>  
                        <field name="productionplanname"/>
                        <field name="productionplanfactory"/>
                        <field name="item_id" options="{'no_open': True}"/>
                        <field name="itemcode"/>
                        <field name="itemname"/> 
                        <field name="fromts"/>
                        <field name="tots"/>                       
                        <field name="lot_code"/>
                        <field name="batch_code"/>
                        <field name="equipment_code"/>
                        <field name="mixing_time"/>
                        <field name="dough_temperature"/>
                        <field name="dough_status"/>
                    </group>

                    <group>
                        <field name="result"/>
                        <field name="operator"/>
                        <field name="note"/>
                        <field name="allowed_item_ids" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_gmp_material_mixing" model="ir.actions.act_window">
        <field name="name">Nhào trộn NPL</field>
        <field name="res_model">gmp.material.mixing</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action Create -->
    <record id="action_gmp_material_mixing_create" model="ir.actions.act_window">
        <field name="name">Nhào trộn NPL (Create)</field>
        <field name="res_model">gmp.material.mixing</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_qr_search_num': active_id}</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_gmp_material_mixing"
        name="Nhào trộn NPL"
        parent="gmp_weighing_monitoring.menu_noodle_production_log_root"
        action="action_gmp_material_mixing"
        sequence="10"
    />


</odoo>
