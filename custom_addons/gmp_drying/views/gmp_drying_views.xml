<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_gmp_drying_tree" model="ir.ui.view">
        <field name="name">gmp.drying.tree</field>
        <field name="model">gmp.drying</field>
        <field name="arch" type="xml">
            <tree>
                <field name="log_datetime"/>
                <field name="productionplan_id"/>
                <field name="productionplancode"/>
                <field name="productionplanname"/>
                <field name="productionplanfactory"/>
                <field name="line_id"/>
                <field name="linecode"/>
                <field name="linename"/>
                <field name="item_id"/>
                <field name="itemcode"/>
                <field name="itemname"/>
                <field name="fromts"/>
                <field name="tots"/>
                <field name="lot_code"/>
                <field name="batch_code"/>
                <field name="drying_time"/>
                <field name="blowing_speed"/>
                <field name="air_tempature"/>
                <field name="airflow_rate"/>
                <field name="equipment_status"/>
                <field name="wip_status"/>               
                <field name="result"/>
                <field name="operator"/>
                <field name="note"/>
                <field name="allowed_item_ids" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_gmp_drying_form" model="ir.ui.view">
        <field name="name">gmp.drying.form</field>
        <field name="model">gmp.drying</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="log_datetime"/>
                        <field name="productionplan_id" options="{'no_open': True}" force_save="1"/>
                        <field name="productionplancode"/>  
                        <field name="productionplanname"/>
                        <field name="productionplanfactory"/>  
                        <field name="line_id"/>
                        <field name="linecode"/>
                        <field name="linename"/> 
                        <field name="item_id"/>
                        <field name="itemcode"/>
                        <field name="itemname"/>
                        <field name="fromts"/>
                        <field name="tots"/>                                           
                        <field name="lot_code"/>
                        <field name="batch_code"/>
                    </group>

                    <group>   
                        <field name="drying_time"/>
                        <field name="blowing_speed"/>
                        <field name="air_tempature"/>
                        <field name="airflow_rate"/>
                        <field name="equipment_status"/>
                        <field name="wip_status"/>     
                    </group>

                    <group>
                        <field name="result"/>
                        <field name="operator"/>
                        <field name="note"/>
                        <field name="allowed_item_ids" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_gmp_drying" model="ir.actions.act_window">
        <field name="name">Quạt ráo</field>
        <field name="res_model">gmp.drying</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action Create -->
    <record id="action_gmp_drying_create" model="ir.actions.act_window">
        <field name="name">Quạt ráo (Create)</field>
        <field name="res_model">gmp.drying</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_qr_search_num': active_id}</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_gmp_drying"
        name="Quạt ráo"
        parent="gmp_weighing_monitoring.menu_noodle_production_log_root"
        action="action_gmp_drying"
        sequence="10"
    />

</odoo>
