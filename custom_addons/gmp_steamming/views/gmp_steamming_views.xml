<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_gmp_steamming_tree" model="ir.ui.view">
        <field name="name">gmp.steamming.tree</field>
        <field name="model">gmp.steamming</field>
        <field name="arch" type="xml">
            <tree>
                <field name="log_datetime"/>
                <field name="log_date" invisible="1"/> 
                <field name="productionplan_id"/>
                <field name="productionplancode"/>
                <field name="productionplanname"/>
                <field name="productionplanfactory"/>
                <field name="line_id"/>
                <field name="linecode"/>
                <field name="linename"/>
                <field name="shift_id"/>
                <field name="shiftcode"/>
                <field name="shiftname"/>
                <field name="item_id"/>
                <field name="itemcode"/>
                <field name="itemname"/>
                <field name="fromts"/>
                <field name="tots"/>
                <field name="lot_code"/>
                <field name="batch_code"/>
                <field name="tempature"/>
                <field name="steamming_time"/>
                <field name="vapor_pressurer"/>
                <field name="chamber_pressuer"/>
                <field name="gelatinization"/>
                <field name="moisture"/>
                <field name="wip_status"/>               
                <field name="result"/>
                <field name="operator"/>
                <field name="note"/>
                <field name="allowed_item_ids" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_gmp_steamming_form" model="ir.ui.view">
        <field name="name">gmp.steamming.form</field>
        <field name="model">gmp.steamming</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="log_datetime"/>
                        <field name="log_date" invisible="1"/> 
                        <field name="productionplan_id" 
                            context="{'search_default_u_docdate': log_date}"
                            domain="[('u_docdate', '=', log_date)]"
                            options="{'no_create': True, 'no_open': True}"/>
                        <field name="productionplancode"/>  
                        <field name="productionplanname"/>
                        <field name="productionplanfactory"/>  .
                        <field name="line_id"/>
                        <field name="linecode"/>
                        <field name="linename"/>
                        <field name="shift_id"/>
                        <field name="shiftcode"/>
                        <field name="shiftname"/>
                        <field name="item_id"/>
                        <field name="itemcode"/>
                        <field name="itemname"/>
                        <field name="fromts"/>
                        <field name="tots"/>                                            
                        <field name="lot_code"/>
                        <field name="batch_code"/>
                    </group>

                    <group>   
                        <field name="tempature"/>
                        <field name="steamming_time"/>
                        <field name="vapor_pressurer"/>
                        <field name="chamber_pressuer"/>
                        <field name="gelatinization"/>
                        <field name="moisture"/>
                        <field name="wip_status"/>     
                    </group>

                    <group>
                        <field name="result"/>
                        <field name="operator"/>
                        <field name="note"/>
                        <field name="allowed_item_ids" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_gmp_steamming" model="ir.actions.act_window">
        <field name="name">Hấp</field>
        <field name="res_model">gmp.steamming</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_gmp_steamming"
        name="Hấp"
        parent="gmp_weighing_monitoring.menu_noodle_production_log_root"
        action="action_gmp_steamming"
        sequence="6"
    />

</odoo>
