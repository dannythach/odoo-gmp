<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Action -->
    <record id="action_production_log" model="ir.actions.act_window">
        <field name="name">Nhật ký sản xuất</field>
        <field name="res_model">production.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_production_root" name="Sản xuất" sequence="10"/>
    <menuitem
        id="menu_production_log"
        name="Nhật ký sản xuất"
        parent="menu_production_root"
        action="action_production_log"
        sequence="10"
    />

    <!-- Tree view -->
    <record id="view_production_log_tree" model="ir.ui.view">
        <field name="name">production.log.tree</field>
        <field name="model">production.log</field>
        <field name="arch" type="xml">
            <tree>
                <field name="log_datetime"/>
                <field name="lot_code"/>
                <field name="batch_code"/>
                <field name="shaft_code"/>
                <field name="speed_raw"/>
                <field name="thickness_raw"/>
                <field name="speed_finish"/>
                <field name="thickness_finish"/>
                <field name="result"/>
                <field name="operator"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_production_log_form" model="ir.ui.view">
        <field name="name">production.log.form</field>
        <field name="model">production.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group col="4">
                        <field name="log_datetime"/>
                        <field name="operator"/>
                        <field name="lot_code"/>
                        <field name="batch_code"/>
                        <field name="shaft_code"/>
                        <field name="result"/>
                    </group>

                    <group string="Cán thô" col="2">
                        <field name="speed_raw"/>
                        <field name="thickness_raw"/>
                    </group>

                    <group string="Cán tinh" col="2">
                        <field name="speed_finish"/>
                        <field name="thickness_finish"/>
                    </group>

                    <group>
                        <field name="condition_after"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
